{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lingkyn/xr-foundry/blob/main/docs/architecture/composition-manifest.schema.json",
  "title": "XR Foundry composition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_version",
    "id",
    "version",
    "engine",
    "component_catalog",
    "capability_registry",
    "components",
    "selections",
    "required_capabilities",
    "bindings",
    "lock_path",
    "claims"
  ],
  "properties": {
    "schema": {"const": "xr-foundry.composition_manifest.v1"},
    "model_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^xr-foundry\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "version": {"$ref": "#/$defs/semver"},
    "engine": {"const": "unity"},
    "component_catalog": {"const": "component-catalog.json"},
    "capability_registry": {"const": "capability-registry.json"},
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/componentSelection"}
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "component", "version"],
        "properties": {
          "slot": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "component": {"type": "string", "pattern": "^com\\.lingkyn\\.[a-z0-9.-]+$"},
          "version": {"$ref": "#/$defs/semver"}
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capabilityReference"}
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from_capability", "to_capability", "owner", "implementation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "from_capability": {"$ref": "#/$defs/capabilityReference"},
          "to_capability": {"$ref": "#/$defs/capabilityReference"},
          "owner": {"const": "consumer_composition_root"},
          "implementation": {"const": "consumer_owned_adapter_pending"}
        }
      }
    },
    "lock_path": {"const": "compositions/unity/reference-system/foundry.lock.json"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural_resolution", "runtime_integration", "unity_compile", "device_runtime"],
      "properties": {
        "structural_resolution": {"const": "verified_by_repository_contract"},
        "runtime_integration": {"const": "not_claimed"},
        "unity_compile": {"const": "not_claimed_for_this_composition"},
        "device_runtime": {"const": "not_claimed"}
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^xr-foundry\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "capabilityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/capabilityId"},
        "version": {"$ref": "#/$defs/semver"}
      }
    },
    "componentSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^com\\.lingkyn\\.[a-z0-9.-]+$"},
        "version": {"$ref": "#/$defs/semver"}
      }
    }
  }
}
