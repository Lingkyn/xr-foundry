{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lingkyn/xr-foundry/blob/main/docs/architecture/composition-manifest.v2.schema.json",
  "title": "XR Foundry composition manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_version",
    "id",
    "version",
    "engine",
    "component_catalog",
    "capability_registry",
    "components",
    "selections",
    "required_capabilities",
    "bindings",
    "lock_path",
    "claims"
  ],
  "properties": {
    "schema": {"const": "xr-foundry.composition_manifest.v2"},
    "model_version": {"const": "0.2.0"},
    "id": {"type": "string", "pattern": "^xr-foundry\\.[a-z0-9]+(?:[.-][a-z0-9]+)*(?![\\s\\S])"},
    "version": {"$ref": "#/$defs/semver"},
    "engine": {"const": "unity"},
    "component_catalog": {"const": "component-catalog.json"},
    "capability_registry": {"const": "capability-registry.json"},
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/componentSelection"}
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "component", "version"],
        "properties": {
          "slot": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?![\\s\\S])"},
          "component": {"type": "string", "pattern": "^com\\.lingkyn\\.[a-z0-9.-]+(?![\\s\\S])"},
          "version": {"$ref": "#/$defs/semver"}
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capabilityReference"}
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from_capability", "to_capability", "owner", "implementation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?![\\s\\S])"},
          "from_capability": {"$ref": "#/$defs/capabilityReference"},
          "to_capability": {"$ref": "#/$defs/capabilityReference"},
          "owner": {"const": "consumer_composition_root"},
          "implementation": {"$ref": "#/$defs/bindingImplementation"}
        }
      }
    },
    "lock_path": {
      "type": "string",
      "pattern": "^compositions/(?:[A-Za-z0-9_][A-Za-z0-9._-]*/)+foundry\\.lock\\.json(?![\\s\\S])"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural_resolution", "runtime_integration", "unity_compile", "device_runtime"],
      "properties": {
        "structural_resolution": {"const": "verified_by_repository_contract"},
        "runtime_integration": {"const": "not_claimed"},
        "unity_compile": {"const": "not_claimed_for_this_composition"},
        "device_runtime": {"const": "not_claimed"}
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^xr-foundry\\.[a-z0-9]+(?:[.-][a-z0-9]+)*(?![\\s\\S])"
    },
    "capabilityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/capabilityId"},
        "version": {"$ref": "#/$defs/semver"}
      }
    },
    "componentSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^com\\.lingkyn\\.[a-z0-9.-]+(?![\\s\\S])"},
        "version": {"$ref": "#/$defs/semver"}
      }
    },
    "bindingImplementation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "status"],
          "properties": {
            "kind": {"const": "consumer_owned_adapter"},
            "status": {"const": "pending"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "status", "source_path", "assembly"],
          "properties": {
            "kind": {"const": "consumer_owned_adapter"},
            "status": {"const": "implemented"},
            "source_path": {
              "type": "string",
              "pattern": "^consumer/(?:[A-Za-z0-9_][A-Za-z0-9._-]*/)*[A-Za-z0-9_][A-Za-z0-9._-]*\\.cs(?![\\s\\S])"
            },
            "assembly": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*(?![\\s\\S])"
            }
          }
        }
      ]
    }
  }
}
