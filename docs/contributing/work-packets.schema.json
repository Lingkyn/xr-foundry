{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lingkyn/xr-foundry/blob/main/docs/contributing/work-packets.schema.json",
  "title": "XR Foundry work packets",
  "description": "Self-contained units of work that any person or coding Agent can pick up without session context. Each packet names what to read, where it may write, what to do, and the commands and artifacts that prove it is done.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "policy", "packets"],
  "properties": {
    "schema": { "const": "xr-foundry.work_packets.v1" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_grants_no_permission",
        "acceptance_is_machine_checked_where_possible",
        "done_needs_proof_path",
        "disjoint_allowed_paths_run_in_parallel"
      ],
      "properties": {
        "packet_grants_no_permission": { "const": true },
        "acceptance_is_machine_checked_where_possible": { "const": true },
        "done_needs_proof_path": { "const": true },
        "disjoint_allowed_paths_run_in_parallel": { "const": true }
      }
    },
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packet" }
    }
  },
  "$defs": {
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "milestone_batch",
        "needs",
        "decision_class",
        "size",
        "status",
        "depends_on",
        "read_first",
        "allowed_paths",
        "steps",
        "acceptance",
        "evidence",
        "done_proof"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^WP-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 8 },
        "milestone_batch": { "type": "string", "pattern": "^[1-3][a-f]$" },
        "needs": { "enum": ["none", "unity_editor", "headset", "maintainer", "outside_contributor"] },
        "decision_class": { "enum": ["routine", "non_routine"] },
        "size": { "enum": ["small", "medium", "large"] },
        "status": { "enum": ["open", "in_progress", "done", "blocked"] },
        "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^WP-[0-9]{3}$" }, "uniqueItems": true },
        "read_first": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commands", "artifacts"],
          "properties": {
            "commands": { "type": "array", "items": { "type": "string", "pattern": "^python scripts/[a-z_]+\\.py( .*)?$|^python -m unittest .*$" } },
            "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "evidence": { "type": "string", "minLength": 8 },
        "done_proof": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
